# Copia este archivo como .env y completa los valores
# IP pública de la EC2 con guiones + .sslip.io   (ej. IP 3.85.12.34 -> 3-85-12-34.sslip.io)
DOMINIO_BASE=3-85-12-34.sslip.io

# Supabase > Project Settings > Database > Connection string (Session pooler, puerto 5432)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Claves internas (genera con: openssl rand -hex 24)
API_TOKEN=cambia-esto
N8N_ENCRYPTION_KEY=cambia-esto-tambien

# URL CSV del Google Sheet del calendario (Archivo > Compartir > Publicar en la web > CSV)
CALENDARIO_CSV_URL=https://docs.google.com/spreadsheets/d/1gK6hQxcly5CQsOkmnzZBWx2Pqnwn6oM6hBLsAZjzkek/export?format=csv

N8N_VERSION=2.47.7

# API key de https://console.anthropic.com (NO la compartas)
ANTHROPIC_API_KEY=
