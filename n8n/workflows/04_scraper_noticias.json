{
  "id": "unabScraperNews1",
  "name": "UNAB Chatbot - 04 Scraper de noticias (programado)",
  "nodes": [
    {
      "parameters": {
        "content": "## Scraper periódico de noticias UNAB\nCada 6 h consulta la API pública de WordPress de unab.edu.co (Estudiantes, Ing. Sistemas, Facultad de Ingeniería) → limpia y etiqueta (CURSOS/CONVOCATORIA/CERTIFICACION/CCD) → upsert en academico.noticia → embeddings para RAG",
        "height": 170,
        "width": 560,
        "color": 5
      },
      "id": "57dacb03-4e99-4a32-8609-0feb85fb5a51",
      "name": "Nota 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -280
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "9f8cb59a-db8b-4994-bf05-b33b568c560a",
      "name": "Cada 6 horas",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -240,
        -40
      ]
    },
    {
      "parameters": {},
      "id": "71250e3f-fd22-4263-819a-535d0bf80cd5",
      "name": "Ejecutar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -240,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "\nreturn [232, 556, 134].map(c => ({ json: { categoria: c } }));\n"
      },
      "id": "4d22ed3a-5912-4601-8798-5d125022a6c7",
      "name": "Categorías a consultar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        40
      ]
    },
    {
      "parameters": {
        "url": "https://unab.edu.co/wp-json/wp/v2/posts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "categories",
              "value": "={{ $json.categoria }}"
            },
            {
              "name": "per_page",
              "value": "10"
            },
            {
              "name": "_fields",
              "value": "id,date,link,title,excerpt,content,categories"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "ChatbotAcademicoUNAB/1.0 (proyecto academico)"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "66415b97-0e16-4bd3-a6ec-daa46fd7776c",
      "name": "GET unab.edu.co wp-json",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        40
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst limpiar = h => String(h || '').replace(/<\\/(p|li|h\\d|tr)>/gi, '\\n').replace(/<br\\s*\\/?>/gi, '\\n').replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&#8217;|&#8216;/g, \"'\").replace(/&#8220;|&#8221;|&quot;/g, '\"').replace(/&#8211;/g, '–')\n  .replace(/&#\\d+;/g, ' ').replace(/[ \\t]+/g, ' ').replace(/\\n\\s*\\n+/g, '\\n\\n').trim();\nconst reglas = [['CCD', /competencias digitales|\\bccd\\b|insignia|interacci[oó]n digital/i], ['CERTIFICACION', /certificaci[oó]n|certificado|examen|celpe|toefl|ielts|prueba de/i],\n  ['CONVOCATORIA', /convocatoria|inscripci|elecciones|beca|postula|abiertas/i], ['CURSOS', /curso|diplomado|taller|vacacional|intensivo|capacitaci/i]];\nconst vistos = new Set(); const out = [];\nfor (const it of $input.all()) {\n  const p = it.json; if (!p || !p.id || vistos.has(p.id)) continue; vistos.add(p.id);\n  const titulo = limpiar(p.title?.rendered), contenido = limpiar(p.content?.rendered);\n  const base = (titulo + ' ' + contenido.slice(0, 600));\n  const etiqueta = (reglas.find(([, rx]) => rx.test(base)) || ['GENERAL'])[0];\n  out.push({ json: { id_wp: p.id, titulo, url: p.link, fecha_pub: p.date, resumen: limpiar(p.excerpt?.rendered).slice(0, 500),\n    contenido, categorias: (p.categories || []).join(','), etiqueta } });\n}\nreturn out;\n"
      },
      "id": "90addd4c-8148-451b-bb37-bef11d153749",
      "name": "Limpiar y etiquetar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO academico.noticia (id_wp, titulo, url, fecha_pub, resumen, contenido, categorias, etiqueta, scraped_at)\nVALUES ($1, $2, $3, $4::timestamp, $5, $6, $7, $8, now())\nON CONFLICT (id_wp) DO UPDATE SET titulo = EXCLUDED.titulo, resumen = EXCLUDED.resumen, contenido = EXCLUDED.contenido,\n  etiqueta = EXCLUDED.etiqueta, scraped_at = now()\nRETURNING id_wp, titulo, etiqueta, (xmax = 0) AS es_nueva, contenido, url, fecha_pub;",
        "options": {
          "queryReplacement": "={{ [ $json.id_wp, $json.titulo, $json.url, $json.fecha_pub, $json.resumen, $json.contenido, $json.categorias, $json.etiqueta ] }}"
        }
      },
      "id": "7eda61e0-2e57-4b38-9dc4-22a436bfce6d",
      "name": "Upsert noticia",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        640,
        40
      ],
      "credentials": {
        "postgres": {
          "id": "supabaseUnab01",
          "name": "Supabase UNAB"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "a4d6211e-aab3-4617-9c10-3692d4555261",
              "leftValue": "={{ $json.es_nueva }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9f9591b8-ebbe-49c6-a3e7-8738bb04e858",
      "name": "¿Es nueva?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        860,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcp:9000/embed",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.API_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ texts: [ '[Noticia UNAB ' + String($json.fecha_pub).slice(0,10) + ' - ' + $json.titulo + '] ' + String($json.contenido).slice(0, 1500) ] }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "75de526c-0eed-44b8-b6c1-78191fca2e9b",
      "name": "Embeddings noticia",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        40
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO academico.documento_chunk (fuente, titulo, seccion, chunk_index, contenido, metadata, embedding)\nVALUES ('noticia', $1, $2, 0, $3, jsonb_build_object('url', $4::text), $5::vector)\nON CONFLICT (fuente, titulo, chunk_index) DO UPDATE SET contenido = EXCLUDED.contenido, embedding = EXCLUDED.embedding;",
        "options": {
          "queryReplacement": "={{ [ $('¿Es nueva?').item.json.titulo, $('¿Es nueva?').item.json.etiqueta, '[Noticia UNAB ' + String($('¿Es nueva?').item.json.fecha_pub).slice(0,10) + ' - ' + $('¿Es nueva?').item.json.titulo + '] ' + String($('¿Es nueva?').item.json.contenido).slice(0,1500), $('¿Es nueva?').item.json.url, $json.pgvector[0] ] }}"
        }
      },
      "id": "ec11e350-5ea6-49c9-9dc9-d3bc40620368",
      "name": "Guardar noticia en PGVector",
      "type": "n8n-nodes-base.postgres",
